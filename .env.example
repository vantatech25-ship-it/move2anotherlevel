# KHOI API Integration Setup

Environment variables and configuration template for MOVE Elite 3.0 integration.

## Step 1: Create `.env` File

Create a new file `.env` in your project root (same level as `index.html`):

```env
# KHOI API Configuration
VITE_KHOI_API_URL=https://api.khoi.com/api/v1
VITE_KHOI_API_KEY=your_actual_api_key_here
VITE_KHOI_USER_ID=your_user_id_here

# Optional: KHOI API configuration
VITE_KHOI_TIMEOUT=10000
VITE_KHOI_CACHE_EXPIRY=300000
```

> ⚠️ **IMPORTANT:** Add `.env.local` to `.gitignore` - Never commit API keys!

```
# Add to .gitignore
.env
.env.local
.env.*.local
```

---

## Step 2: Update `scripts/main.js`

Replace your existing imports with:

```javascript
// MOVE Elite 3.2 - Core Functional Engine with KHOI Integration
import khoi from './khoi-client.js';
import syncManager, { initializeMoveSync, MOVE_SYNC_CONFIG } from './data-sync.js';

document.addEventListener('DOMContentLoaded', () => {
  const state = {
    archetype: null,
    initializing: true,
    currentView: 'home',
    lastBpm: 72,
    khoiSyncInitialized: false  // NEW
  };

  // ... existing code ...

  function startMainEngine() {
    initNavigationSystem();
    initBpmSimulation();
    initScrollEffects();
    
    // NEW: Initialize KHOI sync
    initializeKhoiSync();
    
    console.log("MOVE Elite Engine Online. Archetype:", state.archetype);
  }

  // NEW: Initialize KHOI biometric sync
  async function initializeKhoiSync() {
    try {
      console.log("Initializing KHOI biometric sync...");
      
      // Check KHOI connectivity first
      const isConnected = await khoi.checkConnectivity();
      
      if (!isConnected) {
        console.warn("⚠️ KHOI API unreachable - using mock data");
        return;
      }
      
      // Start sync manager with custom config
      await initializeMoveSync({
        intervals: {
          readiness: 5 * 60 * 1000,    // 5 min
          heartRate: 1 * 60 * 1000,     // 1 min (critical)
          hrv: 10 * 60 * 1000,          // 10 min
          sleep: 60 * 60 * 1000,        // 1 hour
          activity: 15 * 60 * 1000,     // 15 min
          stress: 5 * 60 * 1000,        // 5 min
          recovery: 10 * 60 * 1000,     // 10 min
          workouts: 30 * 60 * 1000,     // 30 min
          nutrition: 30 * 60 * 1000,    // 30 min
          recommendations: 60 * 60 * 1000, // 1 hour
        },
        enabledMetrics: {
          readiness: true,
          heartRate: true,
          hrv: true,
          sleep: true,
          activity: true,
          stress: true,
          recovery: true,
          workouts: true,
          nutrition: true,
          recommendations: true,
        }
      });
      
      state.khoiSyncInitialized = true;
      
      // Listen for readiness updates
      syncManager.on('readiness', ({ data }) => {
        if (data) {
          const moveIndex = khoi.calculateMoveIndex(data);
          const element = document.getElementById('readiness-val');
          if (element) element.textContent = moveIndex;
          
          const statusEl = document.querySelector('.readiness-label');
          if (statusEl) statusEl.textContent = khoi.getReadinessStatus(moveIndex);
        }
      });
      
      // Listen for heart rate updates
      syncManager.on('heart-rate', ({ data }) => {
        if (data && data.bpm) {
          const bpmEl = document.getElementById('global-bpm-val');
          if (bpmEl) bpmEl.textContent = data.bpm;
          state.lastBpm = data.bpm;
        }
      });
      
      // Listen for sync errors
      syncManager.on('sync-error', ({ metricType, error }) => {
        console.error(`❌ KHOI Sync Error [${metricType}]:`, error);
      });
      
      // Listen for connectivity changes
      syncManager.on('connectivity-offline', () => {
        console.warn("📡 Network offline - KHOI sync paused");
      });
      
      syncManager.on('connectivity-online', () => {
        console.log("📡 Network online - KHOI sync resumed");
      });
      
      console.log("✅ KHOI biometric sync initialized");
      
    } catch (error) {
      console.error("❌ Failed to initialize KHOI sync:", error.message);
    }
  }

  // ... rest of existing code ...
});
```

---

## Step 3: Vercel Deployment

### Add Environment Variables

1. Go to https://vercel.com/dashboard
2. Select your `move2anotherlevel` project
3. Click **Settings** → **Environment Variables**
4. Add three variables:

| Variable Name | Value | Source |
|---|---|---|
| `VITE_KHOI_API_URL` | `https://api.khoi.com/api/v1` | KHOI Documentation |
| `VITE_KHOI_API_KEY` | `your_actual_api_key` | KHOI Dashboard |
| `VITE_KHOI_USER_ID` | `your_user_id` | KHOI Dashboard |

5. **Important:** Select `Production`, `Preview`, and `Development` for all variables
6. Click **Save**

### Redeploy

```bash
git add .
git commit -m "Add KHOI integration"
git push origin main
```

Vercel will automatically redeploy with new environment variables.

---

## Step 4: Test Integration

### Local Testing

```bash
# Install dependencies
npm install

# Start dev server
npm run dev

# Open browser console (F12)
# You should see:
# ✅ MOVE Elite Engine Online
# ✅ KHOI biometric sync initialized
```

### Check Network Requests

1. Open browser DevTools (F12)
2. Go to **Network** tab
3. Filter for `api.khoi.com`
4. You should see requests like:
   - `GET /readiness/daily`
   - `GET /metrics/heart-rate/current`
   - `GET /metrics/hrv`

### Verify Data Loading

1. Go to **READINESS** tab
2. Check that values update (not stuck at "96")
3. Check **IDENTITY** tab - should show "LINKED" for KHOI SYNC
4. Open browser Console - should show sync logs

