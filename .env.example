## Example: Per-Hub Integration

### Readiness Hub Updates

```javascript
// In scripts/main.js, inside initializeKhoiSync()

syncManager.on('readiness', ({ data }) => {
  if (!data) return;
  
  // Update MOVE INDEX score
  const moveIndex = khoi.calculateMoveIndex(data);
  const el = document.getElementById('readiness-val');
  if (el) el.textContent = moveIndex;
  
  // Update HRV Ring
  const hrvRing = document.getElementById('ring-hrv');
  if (hrvRing && data.hrv_score) {
    const circumference = 282.7;
    const offset = circumference - (data.hrv_score * circumference);
    hrvRing.style.strokeDashoffset = offset;
  }
  
  // Update Sleep Ring
  const sleepRing = document.getElementById('ring-sleep');
  if (sleepRing && data.sleep_score) {
    const circumference = 232.5;
    const offset = circumference - (data.sleep_score * circumference);
    sleepRing.style.strokeDashoffset = offset;
  }
  
  // Update Activity Ring
  const activityRing = document.getElementById('ring-activity');
  if (activityRing && data.activity_score) {
    const circumference = 182.2;
    const offset = circumference - (data.activity_score * circumference);
    activityRing.style.strokeDashoffset = offset;
  }
});
```

